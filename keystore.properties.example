# ==============================================================================
# JANSAARTHI AI — Android Release Keystore Configuration Template
# Copy this file to `keystore.properties` in the project root.
# IMPORTANT:
# - Never commit `keystore.properties` or your `.jks` file to version control.
# - Both `keystore.properties` and `*.jks` are automatically ignored by .gitignore.
# ==============================================================================

# Relative path from project root to your release keystore file
storeFile=release-keystore.jks

# Keystore password (entered when creating the keystore)
storePassword=your_keystore_password_here

# Key alias name (e.g. jansaarthi-key or upload)
keyAlias=jansaarthi-release-key

# Key password (password for the specific key alias)
keyPassword=your_key_password_here
